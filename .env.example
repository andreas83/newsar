# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/newsar
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=newsar
POSTGRES_USER=username
POSTGRES_PASSWORD=password

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Ollama Configuration (AI Models)
# Primary Ollama URL - can be RunPod, self-hosted, or local
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=qwen2.5:14b-instruct-q5_K_M
OLLAMA_TIMEOUT=30000

# Fallback Ollama (local instance for when primary fails)
OLLAMA_FALLBACK_URL=http://localhost:11435
OLLAMA_FALLBACK_CHAT_MODEL=llama3.2:3b
OLLAMA_FALLBACK_EMBED_MODEL=nomic-embed-text

# ============================================================================
# Cloud LLM Providers (Optional - for API-based processing)
# ============================================================================

# OpenRouter API (primary cloud provider - free tier available)
# Get API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-405b-instruct:free
OPENROUTER_REFERER=https://newsar.codejungle.org

# Google Gemini API (secondary cloud provider - free tier available)
# Get API key from: https://aistudio.google.com/apikey
# Free tier: 15 RPM for gemini-2.0-flash, 1000 RPD for gemini-2.0-flash-lite
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Force a specific LLM provider (optional)
# FORCE_OLLAMA=true    # Skip cloud providers, use Ollama directly
# FORCE_GEMINI=true    # Prefer Gemini over OpenRouter

# LLM Fallback Order:
# 1. OpenRouter (if OPENROUTER_API_KEY set, unless FORCE_OLLAMA/FORCE_GEMINI)
# 2. Gemini (if GEMINI_API_KEY set, unless FORCE_OLLAMA)
# 3. Ollama Primary (OLLAMA_BASE_URL)
# 4. Ollama Fallback (OLLAMA_FALLBACK_URL)

# ============================================================================
# RunPod On-Demand Pod Management (Optional - for cost savings)
# ============================================================================

# RunPod API Key (get from https://www.runpod.io/console/user/settings)
RUNPOD_API_KEY=your_runpod_api_key_here

# RunPod Template ID (create after building Docker image)
# See RUNPOD_RUNBOOK.md for complete setup instructions
RUNPOD_TEMPLATE_ID=your_template_id_here

# GPU type for pod creation
RUNPOD_GPU_TYPE=NVIDIA RTX 4090

# Enable/disable on-demand pod management (false = use static OLLAMA_BASE_URL)
RUNPOD_ENABLED=false

# Pod lifecycle configuration
RUNPOD_POD_IDLE_TIMEOUT=900000      # 15 minutes in ms
RUNPOD_MAX_PODS=1                    # Max concurrent pods
RUNPOD_MAX_COST_PER_DAY=20          # Daily cost limit USD

# Expected savings: 70-80% vs always-on ($180-288/month)

# Application Configuration
NODE_ENV=development
NUXT_PORT=3000

# Admin Login Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-secure-password

# Auth Configuration (generate with: openssl rand -base64 32)
NUXT_SESSION_PASSWORD=change-me-to-a-secure-random-string-min-32-chars

# Anthropic API (optional)
ANTHROPIC_API_KEY=

# Stock Market APIs (optional)
FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=
ALPACA_API_KEY=
ALPACA_API_SECRET=

# BullMQ Configuration
BULLMQ_QUEUE_NAME=newsar-jobs
BULLMQ_CONCURRENCY=5

# ============================================================================
# Transformers.js Feature Flags (Experimental - CPU-based AI models)
# ============================================================================

# Enable transformer models for specific tasks (true = use Transformers.js, false = use Ollama)
USE_TRANSFORMERS_FOR_NER=false         # Named Entity Recognition
USE_TRANSFORMERS_FOR_SENTIMENT=false   # Sentiment Analysis
USE_TRANSFORMERS_FOR_KEYWORDS=false    # Keyword Extraction
USE_TRANSFORMERS_FOR_SUMMARY=false     # Summary Generation

# Performance expectations:
# - NER: 90% faster (25-30s → 1-3s)
# - Sentiment: 95% faster (35s → 1-2s)
# - Keywords: 90% faster (35s → 3-5s)
# - Summary: 80% faster (10-23s → 2-5s)
# - Total pipeline: 60-80% faster overall
# - Cost: 0% GPU cost (runs on CPU)
