# Ollama with Pre-loaded Models for Newsar
# This image contains qwen2.5:14b-instruct-q5_K_M and nomic-embed-text pre-loaded
# to enable fast pod startup (2-3 minutes instead of 6-9 minutes)

FROM ollama/ollama:latest

# Set environment variables
ENV OLLAMA_HOST=0.0.0.0:11434
ENV OLLAMA_ORIGINS=*

# Create a startup script that pulls models during build
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

# Start Ollama in the background and pull models
RUN ollama serve & \
    sleep 5 && \
    echo "Pulling nomic-embed-text (embedding model, ~274MB)..." && \
    ollama pull nomic-embed-text && \
    echo "Pulling qwen2.5:14b-instruct-q5_K_M (chat model, ~9GB)..." && \
    ollama pull qwen2.5:14b-instruct-q5_K_M && \
    echo "Models pulled successfully" && \
    pkill ollama

# Expose Ollama port
EXPOSE 11434

# Health check to verify Ollama is responding
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:11434/api/tags || exit 1

# Start Ollama server
# Note: Base image has ENTRYPOINT ["/bin/ollama"], so CMD should only contain arguments
CMD ["serve"]
